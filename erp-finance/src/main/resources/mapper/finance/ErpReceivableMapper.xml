        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVo">
        select receivable_id, receivable_no, customer_id, customer_name, sales_order_id, sales_order_no,
               source_type, source_id, source_no, invoice_no, receivable_date, due_date, total_amount,
               paid_amount, balance_amount, overdue_days, status, create_by, create_time, update_by,
               update_time, remark
        from erp_receivable
    </sql>

    <select id="selectList" parameterType="com.ruoyi.erp.finance.domain.ErpReceivable" resultMap="ErpReceivableResult">
        <include refid="selectVo"/>
        <where>
            <if test="receivableNo != null and receivableNo != ''">
                AND receivable_no like concat('%', #{receivableNo}, '%')
            </if>
            <if test="customerId != null">
                AND customer_id = #{customerId}
            </if>
            <if test="customerName != null and customerName != ''">
                AND customer_name like concat('%', #{customerName}, '%')
            </if>
            <if test="salesOrderNo != null and salesOrderNo != ''">
                AND sales_order_no like concat('%', #{salesOrderNo}, '%')
            </if>
            <if test="sourceType != null and sourceType != ''">
                AND source_type = #{sourceType}
            </if>
            <if test="sourceNo != null and sourceNo != ''">
                AND source_no like concat('%', #{sourceNo}, '%')
            </if>
            <if test="invoiceNo != null and invoiceNo != ''">
                AND invoice_no like concat('%', #{invoiceNo}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectById" parameterType="Long" resultMap="ErpReceivableResult">
        <include refid="selectVo"/>
        where receivable_id = #{receivableId}
    </select>

    <insert id="insert" parameterType="com.ruoyi.erp.finance.domain.ErpReceivable" useGeneratedKeys="true" keyProperty="receivableId">
