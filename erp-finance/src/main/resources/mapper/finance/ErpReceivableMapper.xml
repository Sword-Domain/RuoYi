            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.ruoyi.erp.finance.domain.ErpReceivable">
        update erp_receivable
        <trim prefix="SET" suffixOverrides=",">
            <if test="receivableNo != null and receivableNo != ''">receivable_no = #{receivableNo},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
