<mapper namespace="com.ruoyi.erp.finance.mapper.ErpReceivableMapper">

    <resultMap type="com.ruoyi.erp.finance.domain.ErpReceivable" id="ErpReceivableResult">
        <result property="receivableId" column="receivable_id"/>
        <result property="receivableNo" column="receivable_no"/>
        <result property="customerId" column="customer_id"/>
        <result property="customerName" column="customer_name"/>
        <result property="salesOrderId" column="sales_order_id"/>
        <result property="salesOrderNo" column="sales_order_no"/>
        <result property="sourceType" column="source_type"/>
