<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.finance.mapper.ErpPayableMapper">

    <resultMap type="com.ruoyi.erp.finance.domain.ErpPayable" id="ErpPayableResult">
        <result property="payableId" column="payable_id"/>
        <result property="payableNo" column="payable_no"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="purchaseOrderId" column="purchase_order_id"/>
        <result property="purchaseOrderNo" column="purchase_order_no"/>
        <result property="sourceType" column="source_type"/>
        <result property="sourceId" column="source_id"/>
        <result property="sourceNo" column="source_no"/>
        <result property="invoiceNo" column="invoice_no"/>
        <result property="payableDate" column="payable_date"/>
        <result property="dueDate" column="due_date"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="paidAmount" column="paid_amount"/>
        <result property="balanceAmount" column="balance_amount"/>
        <result property="overdueDays" column="overdue_days"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVo">
        select payable_id, payable_no, supplier_id, supplier_name, purchase_order_id, purchase_order_no,
               source_type, source_id, source_no, invoice_no, payable_date, due_date, total_amount,
               paid_amount, balance_amount, overdue_days, status, create_by, create_time, update_by,
               update_time, remark
        from erp_payable
    </sql>

    <select id="selectList" parameterType="com.ruoyi.erp.finance.domain.ErpPayable" resultMap="ErpPayableResult">
        <include refid="selectVo"/>
        <where>
            <if test="payableNo != null and payableNo != ''">
                AND payable_no like concat('%', #{payableNo}, '%')
            </if>
            <if test="supplierId != null">
                AND supplier_id = #{supplierId}
            </if>
            <if test="supplierName != null and supplierName != ''">
                AND supplier_name like concat('%', #{supplierName}, '%')
            </if>
            <if test="purchaseOrderNo != null and purchaseOrderNo != ''">
                AND purchase_order_no like concat('%', #{purchaseOrderNo}, '%')
            </if>
            <if test="sourceType != null and sourceType != ''">
                AND source_type = #{sourceType}
            </if>
            <if test="sourceNo != null and sourceNo != ''">
                AND source_no like concat('%', #{sourceNo}, '%')
            </if>
            <if test="invoiceNo != null and invoiceNo != ''">
                AND invoice_no like concat('%', #{invoiceNo}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectById" parameterType="Long" resultMap="ErpPayableResult">
        <include refid="selectVo"/>
        where payable_id = #{payableId}
    </select>

    <insert id="insert" parameterType="com.ruoyi.erp.finance.domain.ErpPayable" useGeneratedKeys="true" keyProperty="payableId">
        insert into erp_payable
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="payableNo != null and payableNo != ''">payable_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="purchaseOrderId != null">purchase_order_id,</if>
            <if test="purchaseOrderNo != null and purchaseOrderNo != ''">purchase_order_no,</if>
            <if test="sourceType != null and sourceType != ''">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="sourceNo != null and sourceNo != ''">source_no,</if>
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no,</if>
            <if test="payableDate != null">payable_date,</if>
            <if test="dueDate != null">due_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="paidAmount != null">paid_amount,</if>
            <if test="balanceAmount != null">balance_amount,</if>
            <if test="overdueDays != null">overdue_days,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="payableNo != null and payableNo != ''">#{payableNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="purchaseOrderId != null">#{purchaseOrderId},</if>
            <if test="purchaseOrderNo != null and purchaseOrderNo != ''">#{purchaseOrderNo},</if>
            <if test="sourceType != null and sourceType != ''">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="sourceNo != null and sourceNo != ''">#{sourceNo},</if>
            <if test="invoiceNo != null and invoiceNo != ''">#{invoiceNo},</if>
            <if test="payableDate != null">#{payableDate},</if>
            <if test="dueDate != null">#{dueDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="paidAmount != null">#{paidAmount},</if>
            <if test="balanceAmount != null">#{balanceAmount},</if>
            <if test="overdueDays != null">#{overdueDays},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.ruoyi.erp.finance.domain.ErpPayable">
        update erp_payable
        <trim prefix="SET" suffixOverrides=",">
            <if test="payableNo != null and payableNo != ''">payable_no = #{payableNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="purchaseOrderId != null">purchase_order_id = #{purchaseOrderId},</if>
            <if test="purchaseOrderNo != null and purchaseOrderNo != ''">purchase_order_no = #{purchaseOrderNo},</if>
            <if test="sourceType != null and sourceType != ''">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="sourceNo != null and sourceNo != ''">source_no = #{sourceNo},</if>
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no = #{invoiceNo},</if>
            <if test="payableDate != null">payable_date = #{payableDate},</if>
            <if test="dueDate != null">due_date = #{dueDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="paidAmount != null">paid_amount = #{paidAmount},</if>
            <if test="balanceAmount != null">balance_amount = #{balanceAmount},</if>
            <if test="overdueDays != null">overdue_days = #{overdueDays},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </trim>
        where payable_id = #{payableId}
    </update>

    <delete id="delete" parameterType="Long">
        delete from erp_payable where payable_id = #{payableId}
    </delete>

    <delete id="deleteByIds" parameterType="String">
        delete from erp_payable where payable_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
