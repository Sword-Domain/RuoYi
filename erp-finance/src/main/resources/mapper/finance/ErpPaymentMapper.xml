<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.finance.mapper.ErpPaymentMapper">

    <resultMap type="com.ruoyi.erp.finance.domain.ErpPayment" id="ErpPaymentResult">
        <result property="paymentId" column="payment_id"/>
        <result property="paymentNo" column="payment_no"/>
        <result property="supplierId" column="supplier_id"/>
        <result property="supplierName" column="supplier_name"/>
        <result property="purchaseOrderId" column="purchase_order_id"/>
        <result property="paymentDate" column="payment_date"/>
        <result property="bankAccountId" column="bank_account_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="handlerId" column="handler_id"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVo">
        select payment_id, payment_no, supplier_id, supplier_name, purchase_order_id, payment_date,
               bank_account_id, total_amount, handler_id, status, create_by, create_time, update_by,
               update_time, remark
        from erp_payment
    </sql>

    <select id="selectList" parameterType="com.ruoyi.erp.finance.domain.ErpPayment" resultMap="ErpPaymentResult">
        <include refid="selectVo"/>
        <where>
            <if test="paymentNo != null and paymentNo != ''">
                AND payment_no like concat('%', #{paymentNo}, '%')
            </if>
            <if test="supplierId != null">
                AND supplier_id = #{supplierId}
            </if>
            <if test="supplierName != null and supplierName != ''">
                AND supplier_name like concat('%', #{supplierName}, '%')
            </if>
            <if test="purchaseOrderId != null">
                AND purchase_order_id = #{purchaseOrderId}
            </if>
            <if test="paymentDate != null">
                AND payment_date = #{paymentDate}
            </if>
            <if test="bankAccountId != null">
                AND bank_account_id = #{bankAccountId}
            </if>
            <if test="handlerId != null">
                AND handler_id = #{handlerId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectById" parameterType="Long" resultMap="ErpPaymentResult">
        <include refid="selectVo"/>
        where payment_id = #{paymentId}
    </select>

    <insert id="insert" parameterType="com.ruoyi.erp.finance.domain.ErpPayment" useGeneratedKeys="true" keyProperty="paymentId">
        insert into erp_payment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="paymentNo != null and paymentNo != ''">payment_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="supplierName != null and supplierName != ''">supplier_name,</if>
            <if test="purchaseOrderId != null">purchase_order_id,</if>
            <if test="paymentDate != null">payment_date,</if>
            <if test="bankAccountId != null">bank_account_id,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="handlerId != null">handler_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="paymentNo != null and paymentNo != ''">#{paymentNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">#{supplierName},</if>
            <if test="purchaseOrderId != null">#{purchaseOrderId},</if>
            <if test="paymentDate != null">#{paymentDate},</if>
            <if test="bankAccountId != null">#{bankAccountId},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="handlerId != null">#{handlerId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>

    <update id="update" parameterType="com.ruoyi.erp.finance.domain.ErpPayment">
        update erp_payment
        <trim prefix="SET" suffixOverrides=",">
            <if test="paymentNo != null and paymentNo != ''">payment_no = #{paymentNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="supplierName != null and supplierName != ''">supplier_name = #{supplierName},</if>
            <if test="purchaseOrderId != null">purchase_order_id = #{purchaseOrderId},</if>
            <if test="paymentDate != null">payment_date = #{paymentDate},</if>
            <if test="bankAccountId != null">bank_account_id = #{bankAccountId},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="handlerId != null">handler_id = #{handlerId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </trim>
        where payment_id = #{paymentId}
    </update>

    <delete id="delete" parameterType="Long">
        delete from erp_payment where payment_id = #{paymentId}
    </delete>

    <delete id="deleteByIds" parameterType="String">
        delete from erp_payment where payment_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
